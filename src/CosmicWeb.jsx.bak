import React, { useRef, useMemo } from 'react'
import { useFrame } from '@react-three/fiber'
import * as THREE from 'three'

// ==========================================
// 1. GALAXY SHADER (1000 Scattered Galaxies)
// ==========================================
const galaxyVertexShader = `
  attribute float instanceSeed;
  #ifndef USE_INSTANCING
    attribute mat4 instanceMatrix;
  #endif
  varying vec2 vUv;
  varying float vSeed;
  
  void main() {
    vUv = uv;
    vSeed = instanceSeed;
    vec4 mvPosition = viewMatrix * modelMatrix * instanceMatrix * vec4(position, 1.0);
    gl_Position = projectionMatrix * mvPosition;
  }
`

const galaxyFragmentShader = `
  uniform float uGlobalOpacity;
  uniform float uTime;
  varying vec2 vUv;
  varying float vSeed;
  
  float random (in vec2 st) { return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123); }
  float noise (in vec2 st) {
      vec2 i = floor(st); vec2 f = fract(st);
      float a = random(i); float b = random(i + vec2(1.0, 0.0));
      float c = random(i + vec2(0.0, 1.0)); float d = random(i + vec2(1.0, 1.0));
      vec2 u = f*f*(3.0-2.0*f);
      return mix(a, b, u.x) + (c - a)* u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
  }
  float fbm (in vec2 st) {
      float value = 0.0; float amplitude = 0.5;
      for (int i = 0; i < 5; i++) {
          value += amplitude * noise(st); st *= 2.0; amplitude *= 0.5;
      }
      return value;
  }

  void main() {
    vec2 cUv = vUv - 0.5; cUv.x *= 2.0; 
    float radius = length(cUv); float angle = atan(cUv.y, cUv.x);
    
    float localTime = uTime * (0.5 + vSeed * 0.5) + (vSeed * 100.0);
    float spiralTwist = radius * 6.0 - localTime * 0.8;
    vec2 twistedUv = vec2(radius * cos(angle - spiralTwist), radius * sin(angle - spiralTwist));
    
    float dustNoise = fbm(twistedUv * 8.0 + localTime * 0.1);
    float fineDust = fbm(twistedUv * 20.0 - localTime * 0.15);
    dustNoise = (dustNoise * 0.7) + (fineDust * 0.3);
    
    float core = exp(-radius * 15.0);
    float disc = exp(-radius * 3.5); 
    
    float cosmicEnergy = (dustNoise * disc * 2.0) + core;
    cosmicEnergy = pow(cosmicEnergy, 1.4);
    
    vec3 coreColor = vec3(1.0, 0.95, 0.8); 
    vec3 midColor = vec3(1.0, 0.4, 0.1);   
    vec3 edgeColor = vec3(0.05, 0.1, 0.8); 
    
    vec3 finalColor = mix(edgeColor, midColor, smoothstep(0.1, 0.5, cosmicEnergy));
    finalColor = mix(finalColor, coreColor, core * 1.5);
    finalColor *= cosmicEnergy * 2.5;
    
    float mask = smoothstep(0.5, 0.1, radius);
    
    // Simple global opacity fade in/out
    float finalAlpha = mask * uGlobalOpacity * clamp(cosmicEnergy * 4.0, 0.0, 1.0);
    gl_FragColor = vec4(finalColor, finalAlpha);
  }
`

// ==========================================
// 2. COSMIC WEB SHADER (The Multiverse Bubbles)
// ==========================================
const webVertexShader = `
  varying vec3 vPosition;
  varying float vSeed;
  attribute float instanceSeed;
  #ifndef USE_INSTANCING
    attribute mat4 instanceMatrix;
  #endif
  
  void main() {
    vPosition = position;
    vSeed = instanceSeed;
    vec4 mvPosition = viewMatrix * modelMatrix * instanceMatrix * vec4(position, 1.0);
    gl_Position = projectionMatrix * mvPosition;
  }
`

// ==========================================
// 3. FINAL MULTIVERSE SHADER (NASA Bubble Universes / Eternal Inflation)
// ==========================================
const nasaVertexShader = `
  varying vec3 vLocalPosition;
  varying vec3 vViewNormal;
  varying float vSeed;
  varying float vSurfaceDist;
  
  void main() {
    vLocalPosition = position;
    
    vec3 centerWorld = (modelMatrix * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    float worldRadius = length((modelMatrix * vec4(1.0, 0.0, 0.0, 0.0)).xyz);
    vSurfaceDist = distance(cameraPosition, centerWorld) - worldRadius;
    
    // Compute view-space normal in vertex shader using normalMatrix (GPU safe!)
    vec3 localNormal = normalize(position);
    vViewNormal = normalize(normalMatrix * localNormal);
    
    vSeed = fract(centerWorld.x * 0.000123 + centerWorld.y * 0.000456 + centerWorld.z * 0.000789);
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`

const nasaFragmentShader = `
  uniform float uOpacity;
  uniform float uTime;
  
  varying vec3 vLocalPosition;
  varying vec3 vViewNormal;
  varying float vSeed;
  varying float vSurfaceDist;
  
  // Continuous Trigonometric Noise
  float fluidFBM(vec3 p, float t) {
      float value = 0.0;
      float amplitude = 0.5;
      float frequency = 3.0;
      
      for (int i = 0; i < 3; i++) { 
          float waveX = sin(p.x * frequency + t) * cos(p.z * frequency - t * 0.5);
          float waveY = cos(p.y * frequency - t) * sin(p.x * frequency + t * 0.5);
          float waveZ = sin(p.z * frequency + t) * cos(p.y * frequency - t * 0.5);
          
          value += (waveX + waveY + waveZ) * amplitude;
          p = p * 1.8;
          frequency *= 1.5;
          amplitude *= 0.5;
          t *= 1.2;
      }
      return (value + 2.0) / 4.0;
  }

  void main() {
    // Proximity fade: fade in only when camera is OUTSIDE the bubble surface
    // vSurfaceDist > 0 means outside, < 0 means inside
    float proximityAlpha = smoothstep(-500000.0, 500000.0, vSurfaceDist);
    
    // Math-perfect spherical normal at every pixel!
    vec3 localNormal = normalize(vLocalPosition);
    
    // Use pre-computed view-space normal from vertex shader
    vec3 viewNormal = normalize(vViewNormal);
    
    float fresnel = dot(viewNormal, vec3(0.0, 0.0, 1.0));
    fresnel = clamp(1.0 - fresnel, 0.0, 1.0);
    fresnel = pow(fresnel, 2.5);
    
    float cmbNoise = fluidFBM(localNormal * 3.0, uTime * 0.05 + vSeed * 100.0);
    float fineNoise = fluidFBM(localNormal * 8.0, -uTime * 0.1);
    float surfaceStr = (cmbNoise * 0.7) + (fineNoise * 0.3);
    
    vec3 baseColor = vec3(0.2 + vSeed*0.6, 0.1 + vSeed*0.4, 0.7 - vSeed*0.5); 
    
    vec3 hotSpot = vec3(1.0, 0.8, 0.2);  
    vec3 coldSpot = vec3(0.0, 0.1, 0.4); 
    vec3 cmbColor = mix(coldSpot, hotSpot, smoothstep(0.3, 0.7, surfaceStr));
    
    vec3 finalColor = mix(baseColor, cmbColor, 0.6);
    
    finalColor += fresnel * 1.5 * baseColor;
    finalColor += fresnel * 0.8 * vec3(1.0);
    
    // Combine fresnel/surface opacity with proximity and global opacity
    float alpha = (fresnel * 0.9 + surfaceStr * 0.15) * uOpacity * proximityAlpha;
    
    gl_FragColor = vec4(finalColor, clamp(alpha, 0.0, 1.0));
  }
`

const webFragmentShader = `
  uniform float uOpacity;
  uniform float uTime;
  varying vec3 vPosition;
  varying float vSeed;
  
  float random(vec3 st) { return fract(sin(dot(st.xyz, vec3(12.9898, 78.233, 45.164))) * 43758.5453123); }
  float noise(vec3 st) {
      vec3 i = floor(st); vec3 f = fract(st);
      float a = random(i); float b = random(i + vec3(1.0, 0.0, 0.0));
      float c = random(i + vec3(0.0, 1.0, 0.0)); float d = random(i + vec3(1.0, 1.0, 0.0));
      float e = random(i + vec3(0.0, 0.0, 1.0)); float g = random(i + vec3(1.0, 0.0, 1.0));
      float h = random(i + vec3(0.0, 1.0, 1.0)); float j = random(i + vec3(1.0, 1.0, 1.0));
      vec3 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(mix(a, b, u.x), mix(c, d, u.x), u.y), mix(mix(e, g, u.x), mix(h, j, u.x), u.y), u.z);
  }

  float ridge(float h, float offset) {
      h = abs(h); h = offset - h; h = h * h; return h;
  }

  float ridgeFbm(vec3 st) {
      float value = 0.0; float amplitude = 0.5; float frequency = 1.0; float offset = 0.9; 
      for (int i = 0; i < 5; i++) {
          float n = noise(st * frequency + uTime * 0.05); 
          n = n * 2.0 - 1.0; 
          value += ridge(n, offset) * amplitude;
          frequency *= 2.0; amplitude *= 0.5;
      }
      return value;
  }

  void main() {
    vec3 pos = normalize(vPosition);
    vec3 offsetPos = pos * 4.0 + (vSeed * 100.0); 
    
    float web = ridgeFbm(offsetPos);
    float detailWeb = ridgeFbm(offsetPos * 3.0 - (uTime * 0.1));
    float energy = (web * 0.7) + (detailWeb * 0.5);
    energy = pow(energy, 2.5);
    
    // NASA-style Multiverse colors
    vec3 spaceColor = vec3(0.0, 0.0, 0.01 + vSeed * 0.02);
    vec3 edgeColor = vec3(0.05, 0.15, 0.7 + vSeed * 0.3); // deep blue/cyan
    vec3 midColor = vec3(0.8, 0.2 + vSeed * 0.5, 0.6);   // magenta/purple
    vec3 coreColor = vec3(1.0, 0.9, 0.95);               // intense white/pink core
    
    vec3 finalColor = mix(spaceColor, edgeColor, smoothstep(0.1, 0.4, energy));
    finalColor = mix(finalColor, midColor, smoothstep(0.5, 0.8, energy));
    finalColor = mix(finalColor, coreColor, smoothstep(0.9, 1.0, energy));
    finalColor *= (energy * 2.0);
    
    gl_FragColor = vec4(finalColor, uOpacity * clamp(energy * 2.5, 0.0, 1.0));
  }
`


export default function CosmicWeb({ activeCenter = [0, 0, 0], onGalaxyClick }) {
  const instancedMeshRef = useRef()
  const galaxyMatRef = useRef()
  
  const webRef = useRef()
  const webMatRef = useRef()
  
  // NASA Multiverse Boundary Refs
  const nasaRef = useRef()
  const nasaMatRef = useRef()
  
  const GALAXY_COUNT = 1000 
  const UNIVERSE_RADIUS = 120000 
  const MULTIVERSE_COUNT = 100
  
  const dummy = useMemo(() => new THREE.Object3D(), [])
  
  // 1000 Galaxies Positions and Seeds
  const { positions, seedArray } = useMemo(() => {
    const pos = []
    const seeds = new Float32Array(GALAXY_COUNT)
    for (let i = 0; i < GALAXY_COUNT; i++) {
      // Push galaxies MUCH further out so the main Milky Way has huge empty space around it
      const radius = 250000 + (1000000 * Math.cbrt(Math.random())) 
      const theta = Math.random() * 2 * Math.PI
      const phi = Math.acos((Math.random() * 2) - 1)
      
      const x = radius * Math.sin(phi) * Math.cos(theta)
      const y = radius * Math.sin(phi) * Math.sin(theta)
      const z = radius * Math.cos(phi)
      
      pos.push(new THREE.Vector3(x, y, z))
      seeds[i] = Math.random()
    }
    return { positions: pos, seedArray: seeds }
  }, [])
  
  // 100 Cosmic Webs Positions and Seeds
  const { multiPositions, multiSeeds } = useMemo(() => {
    const pos = []
    const seeds = new Float32Array(MULTIVERSE_COUNT)
    
    // Universe 0 is OUR universe, fixed at Origin
    pos.push(new THREE.Vector3(0, 0, 0))
    seeds[0] = Math.random()
    
    for (let i = 1; i < MULTIVERSE_COUNT; i++) {
      // Cosmic Webs pushed back to 2 Million - 10 Million
      const radius = 2000000 + Math.random() * 8000000 
      const theta = Math.random() * 2 * Math.PI
      const phi = Math.acos((Math.random() * 2) - 1)
      const x = radius * Math.sin(phi) * Math.cos(theta)
      const y = radius * Math.sin(phi) * Math.sin(theta)
      const z = radius * Math.cos(phi)
      
      pos.push(new THREE.Vector3(x, y, z))
      seeds[i] = Math.random()
    }
    return { multiPositions: pos, multiSeeds: seeds }
  }, [])

  // 100 Multiverses Positions and Data
  // NOTE: No origin bubble! Camera starts inside it so it would be invisible always.
  const multiversesData = useMemo(() => {
    const data = []
    for (let i = 0; i < MULTIVERSE_COUNT; i++) {
      // Scattered 3M to 20M from origin - clearly visible on zoom out
      const radius = 3000000 + Math.random() * 17000000 
      const theta = Math.random() * 2 * Math.PI
      const phi = Math.acos((Math.random() * 2) - 1)
      const x = radius * Math.sin(phi) * Math.cos(theta)
      const y = radius * Math.sin(phi) * Math.sin(theta)
      const z = radius * Math.cos(phi)
      const scale = 0.4 + Math.random() * 0.8
      data.push({ pos: [x, y, z], scale })
    }
    return data
  }, [])

  const galaxyUniforms = useMemo(() => ({ uGlobalOpacity: { value: 0.0 }, uTime: { value: 0.0 } }), [])
  const webUniforms = useMemo(() => ({ uOpacity: { value: 0.0 }, uTime: { value: 0.0 } }), [])
  const nasaUniforms = useMemo(() => ({ uOpacity: { value: 0.0 }, uTime: { value: 0.0 } }), [])

  // Position the 1000 Galaxies
  React.useLayoutEffect(() => {
    if (!instancedMeshRef.current) return
    positions.forEach((pos, i) => {
      dummy.position.copy(pos)
      dummy.rotation.set((Math.random() - 0.5) * Math.PI, (Math.random() - 0.5) * Math.PI, Math.random() * Math.PI)
      const scale = 0.5 + Math.random() * 1.5 // Bigger scale variation
      dummy.scale.set(scale, scale, scale)
      dummy.updateMatrix()
      instancedMeshRef.current.setMatrixAt(i, dummy.matrix)
    })
    instancedMeshRef.current.instanceMatrix.needsUpdate = true
  }, [positions, dummy])

  // Position the 100 Cosmic Webs
  React.useLayoutEffect(() => {
    if (!webRef.current) return
    multiPositions.forEach((pos, i) => {
      dummy.position.copy(pos)
      const scale = 1.0 + Math.random() * 2.0 // Boosted scale!
      dummy.scale.set(scale, scale, scale)
      dummy.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0)
      dummy.updateMatrix()
      webRef.current.setMatrixAt(i, dummy.matrix)
    })
    webRef.current.instanceMatrix.needsUpdate = true
  }, [multiPositions, dummy])

  useFrame((state) => {
    const time = state.clock.elapsedTime
    const camera = state.camera
    // Always measure from absolute origin so clicking a galaxy doesn't reset cosmic zoom!
    const dist = camera.position.length()
    
    // --- GALAXY ANIMATION & PROGRESSIVE REVEAL ---
    if (instancedMeshRef.current && galaxyMatRef.current) {
      instancedMeshRef.current.rotation.y += 0.00002
      let globalOpacity = 0.0
      // Greatly delayed fade-in so the main galaxy remains alone for a long zoom!
      if (dist > 150000 && dist <= 300000) { globalOpacity = (dist - 150000) / 150000 } 
      else if (dist > 300000 && dist <= 600000) { globalOpacity = 1.0 }
      else if (dist > 600000 && dist <= 900000) { globalOpacity = 1.0 - ((dist - 600000) / 300000) }
      
      galaxyMatRef.current.uniforms.uGlobalOpacity.value = Math.max(0, globalOpacity)
      galaxyMatRef.current.uniforms.uTime.value = time
      instancedMeshRef.current.visible = globalOpacity > 0
    }

    // --- 100 COSMIC WEBS ANIMATION ---
    if (webRef.current && webMatRef.current) {
      webRef.current.rotation.y += 0.00005
      webRef.current.rotation.x += 0.00002
      let webOpacity = 0
      // Fade in after 800,000 distance
      if (dist > 800000) { webOpacity = Math.min((dist - 800000) / 400000, 1.0) }
      webMatRef.current.uniforms.uOpacity.value = webOpacity
      webMatRef.current.uniforms.uTime.value = time
      webRef.current.visible = webOpacity > 0
    }
    
    // --- 100 MULTIVERSES (NASA BUBBLE UNIVERSES) ANIMATION ---
    const multOp = Math.min(1.0, Math.max(0, (dist - 500000) / 500000))
    if (nasaRef.current && nasaMatRef.current) {
      nasaMatRef.current.uniforms.uTime.value = time
      nasaMatRef.current.uniforms.uOpacity.value = multOp
    }
    // DEBUG LOG every 2 seconds
    if (Math.floor(time * 0.5) !== Math.floor((time - 0.016) * 0.5)) {
      console.log(`[MULTIVERSE] dist=${Math.round(dist)} opacity=${multOp.toFixed(3)} nasaRef=${!!nasaRef.current} nasaMat=${!!nasaMatRef.current} children=${nasaRef.current?.children?.length}`)
    }
  })

  // We only need ONE shader material instance, shared across all 100 meshes!
  const sharedNasaMaterial = useMemo(() => {
    const mat = new THREE.ShaderMaterial({
      vertexShader: nasaVertexShader,
      fragmentShader: nasaFragmentShader,
      uniforms: nasaUniforms,
      transparent: true,
      depthWrite: false,
      depthTest: false,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide,
      fog: false
    })
    nasaMatRef.current = mat
    return mat
  }, [nasaUniforms])

  return (
    <group>
      {/* 3. The 100 Multiverses (NASA Bubbles) - Unit Sphere Geometry bypasses Float32 buffer quantization */}
      <group ref={nasaRef}>
        {multiversesData.map((mv, i) => (
          <mesh key={i} position={mv.pos} scale={4000000 * mv.scale} renderOrder={-1} material={sharedNasaMaterial}>
            <sphereGeometry args={[1, 64, 64]} />
          </mesh>
        ))}
      </group>

      {/* 1000 Galaxies */}
      <instancedMesh 
        ref={instancedMeshRef} 
        args={[null, null, GALAXY_COUNT]}
        frustumCulled={false}
        onClick={(e) => {
          e.stopPropagation()
          if (e.instanceId !== undefined && onGalaxyClick) {
            const pos = positions[e.instanceId]
            onGalaxyClick([pos.x, pos.y, pos.z])
          }
        }}
      >
        <planeGeometry args={[35000, 17500]}>
          <instancedBufferAttribute attach="attributes-instanceSeed" args={[seedArray, 1]} />
        </planeGeometry>
        <shaderMaterial 
          ref={galaxyMatRef}
          vertexShader={galaxyVertexShader}
          fragmentShader={galaxyFragmentShader}
          uniforms={galaxyUniforms}
          transparent={true}
          depthWrite={false}
          blending={THREE.AdditiveBlending}
          side={THREE.DoubleSide}
        />
      </instancedMesh>

      {/* The Multiverse (100 True Cosmic Webs) */}
      <instancedMesh ref={webRef} args={[null, null, MULTIVERSE_COUNT]} frustumCulled={false}>
        <sphereGeometry args={[UNIVERSE_RADIUS, 64, 64]}>
           <instancedBufferAttribute attach="attributes-instanceSeed" args={[multiSeeds, 1]} />
        </sphereGeometry>
        <shaderMaterial 
          ref={webMatRef}
          vertexShader={webVertexShader}
          fragmentShader={webFragmentShader}
          uniforms={webUniforms}
          transparent={true}
          depthWrite={false}
          blending={THREE.AdditiveBlending}
          side={THREE.DoubleSide}
          fog={false} 
        />
      </instancedMesh>
    </group>
  )
}
